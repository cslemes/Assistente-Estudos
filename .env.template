# ──────────────────────────────────────────────
# Vector DB
# ──────────────────────────────────────────────
QDRANT_URL=""           # e.g. https://xxx.us-east4-0.gcp.cloud.qdrant.io
QDRANT_API_KEY=""

# ──────────────────────────────────────────────
# LLM — chat, summarisation, flashcards
# ──────────────────────────────────────────────
# Provider: "groq" (default, free) | "openai"
LLM_PROVIDER="groq"

GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# ──────────────────────────────────────────────
# Transcription
# ──────────────────────────────────────────────
# Provider: "deepgram" (default) | "openai" | "groq"
TRANSCRIPTION_PROVIDER="deepgram"

DEEPGRAM_API_KEY=""
OPENAI_WHISPER_MODEL="whisper-1"
GROQ_WHISPER_MODEL="whisper-large-v3-turbo"

# ──────────────────────────────────────────────
# RunPod Serverless GPU Workers
# ──────────────────────────────────────────────
# Set USE_RUNPOD=true to delegate GPU tasks to RunPod workers.
# Leave false to run GPU models locally (requires CUDA).
USE_RUNPOD=false

RUNPOD_API_KEY=""
# Override for local GPU mock (docker compose --profile gpu):
# RUNPOD_BASE_URL="http://gpu-workers:8001/v2"

# Endpoint IDs from your RunPod Serverless dashboard:
RUNPOD_CLIP_ENDPOINT_ID=""
RUNPOD_EMBED_ENDPOINT_ID=""
RUNPOD_NER_ENDPOINT_ID=""
RUNPOD_OCR_ENDPOINT_ID=""

# ──────────────────────────────────────────────
# Cloudflare R2 — slide thumbnails
# ──────────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_BUCKET_NAME=""
CLOUDFLARE_R2_PUBLIC_URL=""     # e.g. https://pub-xxx.r2.dev

# ──────────────────────────────────────────────
# Hugging Face (NER model download)
# ──────────────────────────────────────────────
HUGGINGFACE_TOKEN=""

# ──────────────────────────────────────────────
# LangSmith tracing (optional)
# ──────────────────────────────────────────────
LANGSMITH_API_KEY=""
# LANGSMITH_TRACING=true
