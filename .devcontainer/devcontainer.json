{
  "name": "uv",
  "build": { "dockerfile": "Dockerfile" },
  "remoteUser": "developer",
  "runArgs": [
    "--gpus", "all",
    "--ipc=host"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "streetsidesoftware.code-spell-checker",
        "esbenp.prettier-vscode"
      ]
    }
  }
}
