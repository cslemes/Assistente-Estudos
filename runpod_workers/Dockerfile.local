# Combined GPU image for local integration testing only.
# Contains all four worker handlers + the mock server in a single container.
# NOT for production — each worker gets its own image in production.
FROM runpod/base:0.6.2-cuda12.1.0

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN pip install --no-cache-dir \
    "torch>=2.2.0" \
    "torchvision>=0.17.0" \
    "transformers>=4.40.0" \
    "Pillow>=10.0.0" \
    "fastembed-gpu>=0.8.0" \
    "onnxruntime-gpu>=1.25.0" \
    "easyocr>=1.7.2" \
    "numpy>=1.24.0" \
    "fastapi>=0.115.0" \
    "uvicorn>=0.30.0" \
    "runpod>=1.7.0"

COPY clip/handler.py ./clip/handler.py
COPY clip/__init__.py ./clip/__init__.py
COPY embed/handler.py ./embed/handler.py
COPY embed/__init__.py ./embed/__init__.py
COPY ner/handler.py ./ner/handler.py
COPY ner/__init__.py ./ner/__init__.py
COPY ocr/handler.py ./ocr/handler.py
COPY ocr/__init__.py ./ocr/__init__.py
COPY mock_server.py .

EXPOSE 8001
CMD ["python", "mock_server.py"]
